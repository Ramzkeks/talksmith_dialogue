      "text": "Blue route selected.",
      "sound": "",
      "gesture": "",
      "actions": [
        { "id": "core.emit_event", "params": { "event": "random_route_selected", "data": "blue" } }
      ],
      "options": [
        {
          "text": "Go back.",
          "next": "router",
          "next_random": [],
          "gesture": "",
          "conditions": [],
          "actions": []
        }
      ]
    },
    "route_green": {
