      "text": "Green route selected.",
      "sound": "",
      "gesture": "",
      "actions": [
        { "id": "core.emit_event", "params": { "event": "random_route_selected", "data": "green" } }
      ],
      "options": [
        {
          "text": "Go back.",
          "next": "router",
          "next_random": [],
