            { "id": "darkrp.has_money", "params": { "amount": 100 } }
          ],
          "actions": []
        },
        {
          "text": "Получить выплату сотрудника CP.",
          "next": "cp_allowance",
          "next_random": [],
          "gesture": "",
          "conditions": [
            { "id": "darkrp.is_cp", "params": {} },
            { "id": "core.flag_is_not_set", "params": { "key": "demo_cp_allowance" } }
          ],
          "actions": []
