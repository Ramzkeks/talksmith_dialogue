          "next": "citizen_bonus",
          "next_random": [],
          "gesture": "",
          "conditions": [
            { "id": "darkrp.is_job", "params": { "job": "citizen" } },
            { "id": "core.flag_is_not_set", "params": { "key": "demo_citizen_bonus" } }
